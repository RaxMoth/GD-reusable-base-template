; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Base Template"
config/description="Reusable, mobile-first 2D game foundation."
config/version="0.1.0"
run/main_scene="res://Scenes/Boot/Boot.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.0784314, 0.0901961, 0.12549, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Types="*res://Globals/types.gd"
Global="*res://Globals/global.gd"
Events="*res://Globals/events.gd"
Platform="*res://Globals/platform.gd"
Settings="*res://Globals/settings.gd"
SaveManager="*res://Globals/save_manager.gd"
Profile="*res://Globals/profile.gd"
Audio="*res://Globals/audio_manager.gd"
Pools="*res://Globals/pool_manager.gd"
Analytics="*res://Globals/analytics.gd"
Ads="*res://Globals/ads.gd"
Store="*res://Globals/store.gd"
UI="*res://Globals/UI/UI.tscn"
SceneManager="*res://Globals/SceneManager/SceneManager.tscn"
Debug="*res://Globals/Debug/DebugOverlay.tscn"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/energy_saving/keep_screen_on=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_state_charts/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "pink",
"res://Docs/": "gray",
"res://Globals/": "orange",
"res://Ressources/": "green",
"res://Scenes/": "blue",
"res://Scripts/": "red"
}

[gui]

theme/custom="res://Assets/Themes/main_theme.tres"
common/drop_mouse_on_gui_input_disabled=true

