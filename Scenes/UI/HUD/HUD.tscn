[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/UI/HUD/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://Scripts/UI/safe_area_container.gd" id="2_safe_area_"]
[ext_resource type="Script" path="res://Scripts/UI/currency_display.gd" id="3_currency_d"]

[node name="HUD" type="CanvasLayer"]
layer = 10
script = ExtResource("1_hud")

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_safe_area_")
base_margin = 20

[node name="Layout" type="VBoxContainer" parent="SafeArea"]
layout_mode = 2
mouse_filter = 2

[node name="TopBar" type="HBoxContainer" parent="SafeArea/Layout"]
layout_mode = 2
mouse_filter = 2

[node name="PauseButton" type="Button" parent="SafeArea/Layout/TopBar"]
layout_mode = 2
custom_minimum_size = Vector2(92, 92)
theme_type_variation = &"IconButton"
text = "II"

[node name="ScoreBox" type="VBoxContainer" parent="SafeArea/Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="ScoreCaption" type="Label" parent="SafeArea/Layout/TopBar/ScoreBox"]
layout_mode = 2
theme_type_variation = &"SmallLabel"
text = "Score"
horizontal_alignment = 1

[node name="ScoreLabel" type="Label" parent="SafeArea/Layout/TopBar/ScoreBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "0"
horizontal_alignment = 1

[node name="TimerLabel" type="Label" parent="SafeArea/Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "0:00"

[node name="CurrencyDisplay" type="PanelContainer" parent="SafeArea/Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("3_currency_d")

[node name="ProgressBar" type="ProgressBar" parent="SafeArea/Layout"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 26)
mouse_filter = 2
show_percentage = false

[node name="ProgressLabel" type="Label" parent="SafeArea/Layout/ProgressBar"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 18
text = ""
horizontal_alignment = 1
vertical_alignment = 1

[node name="Spacer" type="Control" parent="SafeArea/Layout"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="ActionBar" type="HBoxContainer" parent="SafeArea/Layout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 16

[node name="CenterMessage" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 14
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_top = -60.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"TitleLabel"
text = "Ready?"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

[connection signal="pressed" from="SafeArea/Layout/TopBar/PauseButton" to="." method="_on_pause_button_pressed"]
