[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/Menus/Shop/shop_item_row.gd" id="1_shop_item_"]

[node name="ShopItemRow" type="PanelContainer"]
theme_type_variation = &"CardPanel"
script = ExtResource("1_shop_item_")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Info" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
layout_mode = 2
text = "Item"

[node name="DescriptionLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
text = "Description"
autowrap_mode = 3

[node name="DetailLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(0.55, 0.75, 1, 1)
text = "Lv 0"

[node name="BuyButton" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
custom_minimum_size = Vector2(200, 88)
theme_type_variation = &"SuccessButton"
theme_override_font_sizes/font_size = 28
text = "Buy"

[connection signal="pressed" from="Row/BuyButton" to="." method="_on_buy_button_pressed"]
